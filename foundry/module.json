{
  "id": "vaults",
  "title": "Wizzlethorpe Vaults",
  "description": "Read an Obsidian vault published with Wizzlethorpe Vaults into Foundry VTT. Registers a Graft provider, so a vault's documents are built from its deployment and stay updatable without reinstalling anything.",
  "version": "0.14.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/vaults.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "authors": [
    {
      "name": "Wizzlethorpe Labs",
      "url": "https://vaults.wizzlethorpe.com"
    }
  ],
  "url": "https://github.com/wizzlethorpe/vaults",
  "manifest": "https://github.com/wizzlethorpe/vaults/releases/latest/download/module.json",
  "download": "https://github.com/wizzlethorpe/vaults/releases/latest/download/module.zip",
  "license": "MIT",
  "relationships": {
    "requires": [
      {
        "id": "graft",
        "type": "module",
        "manifest": "https://github.com/wizzlethorpe/graft/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "0.2.0"
        }
      }
    ]
  }
}
